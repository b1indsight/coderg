+#[derive(Default)]
+struct ExtractionLane {
+    current: Option<(usize, FileChunks)>,
+}
+
+type LaneResult = (
+    ExtractionLane,
+    Result<Option<(usize, Vec<ngram::GramHash>)>>,
+);
+
+fn spawn_lane<'scope>(
+    scope: &rayon::Scope<'scope>,
+    sender: mpsc::Sender<LaneResult>,
+    mut lane: ExtractionLane,
+    root: &'scope Path,
+    files: &'scope [(u32, FileState)],
+    next_file: &'scope AtomicUsize,
+) {
+    scope.spawn(move |_| {
+        // At most `workers` jobs are outstanding. Each emits one bounded
+        // message without blocking a Rayon worker needed by a concurrent sort.
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            lane.next(root, files, next_file)
+        }))
+        .unwrap_or_else(|_| Err(anyhow::anyhow!("index extraction worker panicked")));
+        let _ = sender.send((lane, result));
+    });
+}
+
+impl ExtractionLane {
+    fn next(
+        &mut self,
+        root: &Path,
+        files: &[(u32, FileState)],
+        next_file: &AtomicUsize,
+    ) -> Result<Option<(usize, Vec<ngram::GramHash>)>> {
+        loop {
+            if self.current.is_none() {
+                let position = next_file.fetch_add(1, Ordering::Relaxed);
+                let Some((_, state)) = files.get(position) else {
+                    return Ok(None);
+                };
+                self.current = Some((position, FileChunks::open(root.join(&state.path))?));
+            }
+            let (position, chunks) = self.current.as_mut().unwrap();
+            if let Some(hashes) = chunks.next()? {
+                return Ok(Some((*position, hashes)));
+            }
+            self.current = None;
+        }
+    }
+}
+
+struct FileChunks {
+    path: PathBuf,
+    file: File,
+    bytes: Box<[u8; CHUNK_BYTES]>,
+    retained: usize,
+    done: bool,
+}
+
+impl FileChunks {
+    fn open(path: PathBuf) -> Result<Self> {
+        let file = File::open(&path).with_context(|| format!("cannot read {}", path.display()))?;
+        Ok(Self {
+            path,
+            file,
+            bytes: Box::new([0; CHUNK_BYTES]),
+            retained: 0,
+            done: false,
+        })
+    }
+
+    fn next(&mut self) -> Result<Option<Vec<ngram::GramHash>>> {
+        if self.done {
+            return Ok(None);
+        }
+        let mut len = self.retained;
+        while len < self.bytes.len() {
+            match self.file.read(&mut self.bytes[len..]) {
+                Ok(0) => break,
+                Ok(count) => len += count,
+                Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(error) => {
+                    return Err(error)
+                        .with_context(|| format!("cannot read {}", self.path.display()));
+                }
+            }
+        }
+        if (self.retained == 0 && is_binary(&self.bytes[..len]))
+            || (self.retained > 0 && len == self.retained)
+        {
+            self.done = true;
+            return Ok(None);
+        }
+        let hashes = ngram::hashes_for_document(&self.bytes[..len])
+            .into_iter()
+            .collect();
+        self.done = len < self.bytes.len();
+        if !self.done {
+            self.retained = ngram::MAX_GRAM - 1;
+            self.bytes.copy_within(len - self.retained..len, 0);
+        }
+        Ok(Some(hashes))
+    }
+}
