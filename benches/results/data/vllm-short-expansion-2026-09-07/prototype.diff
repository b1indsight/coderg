+#[cfg(test)]
+mod short_probe_tests {
+    use super::*;
+
+    #[test]
+    fn expanded_filter_covers_byte_contexts_and_document_edges() {
+        for literal in [b"if".as_slice(), b"qx".as_slice()] {
+            for bounded in [false, true] {
+                let hashes = expanded_hashes(literal, bounded);
+                let pattern = if bounded { format!(r"\b{}\b", std::str::from_utf8(literal).unwrap()) }
+                              else { std::str::from_utf8(literal).unwrap().to_owned() };
+                let regex = Regex::new(&pattern).unwrap();
+                let check = |document: &[u8]| {
+                    if regex.is_match(document) && document.len() != 2 {
+                        let grams = ngram::hashes_for_document(document);
+                        assert!(hashes.iter().any(|hash| grams.contains(hash)), "{document:?}");
+                    }
+                };
+                check(literal);
+                for left in 0..=255_u8 {
+                    check(&[left, literal[0], literal[1]]);
+                    check(&[literal[0], literal[1], left]);
+                    for right in 0..=255_u8 {
+                        check(&[left, literal[0], literal[1], right]);
+                    }
+                }
+                for context in ["。", "é", "中", "\u{2003}", "\n", "(", " "] {
+                    check(format!("{context}{}{context}", std::str::from_utf8(literal).unwrap()).as_bytes());
+                }
+            }
+        }
+    }
+}
