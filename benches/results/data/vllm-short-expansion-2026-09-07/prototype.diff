+// Experimental query-only expansion. All postings are unioned, and original
+// regex verification is unchanged. No production budget or index format change.
+fn probe_literal(pattern: &str, fixed: bool) -> Option<(&[u8], bool)> {
+    let (literal, bounded) = if !fixed {
+        if let Some(inner) = pattern.strip_prefix(r"\b").and_then(|p| p.strip_suffix(r"\b")) {
+            (inner.as_bytes(), true)
+        } else {
+            (pattern.as_bytes(), false)
+        }
+    } else {
+        (pattern.as_bytes(), false)
+    };
+    (literal.len() == 2 && literal.iter().all(u8::is_ascii_alphanumeric))
+        .then_some((literal, bounded))
+}
+
+fn expanded_hashes(literal: &[u8], bounded: bool) -> BTreeSet<ngram::GramHash> {
+    let mut hashes = BTreeSet::new();
+    for adjacent in 0..=255_u8 {
+        // Non-ASCII bytes are retained conservatively: \b is Unicode-aware.
+        if bounded && (adjacent.is_ascii_alphanumeric() || adjacent == b'_') {
+            continue;
+        }
+        hashes.insert(ngram::best_hash(&[adjacent, literal[0], literal[1]]).unwrap());
+        hashes.insert(ngram::best_hash(&[literal[0], literal[1], adjacent]).unwrap());
+    }
+    hashes
+}
+
+fn expanded_candidates(index: &index::DiskIndex, literal: &[u8], bounded: bool) -> Result<(Vec<u32>, usize)> {
+    let hashes = expanded_hashes(literal, bounded);
+    let mut seen = vec![false; index.manifest.documents.len()];
+    // A whole two-byte document has no trigram. Longer files always have a
+    // preceding OR following byte, including occurrences exactly at BOF/EOF.
+    for (id, document) in index.manifest.documents.iter().enumerate() {
+        if document.active && document.searchable && document.len == 2 {
+            seen[id] = true;
+        }
+    }
+    for &hash in &hashes {
+        for id in index.postings(hash)? {
+            seen[id as usize] = true;
+        }
+    }
+    let candidates = seen.into_iter().enumerate()
+        .filter_map(|(id, present)| present.then_some(id as u32)).collect();
+    Ok((candidates, hashes.len()))
+}
